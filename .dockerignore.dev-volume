# Dockerignore for development volume setup
# We only need pyproject.toml and README.md for dependency installation

# Ignore source code (will be mounted as volumes)
fish_speech/
tools/
docs/

# Ignore build artifacts
build/
fish_speech.egg-info/
__pycache__/
*.pyc
*.pyo
*.pyd

# Ignore checkpoints (will be mounted if needed)
checkpoints/

# Ignore git and IDE files
.git/
.gitignore
.vscode/
.idea/
*.swp
*.swo

# Ignore Docker files (except the one we're using)
Dockerfile
dockerfile.dev
docker-compose.dev.yml
docker-compose.volume.yml
.dockerignore

# Ignore other files
*.log
.env
.DS_Store
